{
  "name": "portfolio-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/assert-neon-env.mjs runtime && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test src/lib/github/*.test.ts src/lib/skills/*.test.ts src/lib/cv/*.test.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/assert-neon-env.mjs migration && prisma migrate dev",
    "db:deploy": "node scripts/assert-neon-env.mjs migration && prisma migrate deploy",
    "db:seed": "node scripts/assert-neon-env.mjs runtime && tsx prisma/seed.ts",
    "db:studio": "node scripts/assert-neon-env.mjs migration && prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@radix-ui/react-accordion": "~1.2.19",
    "@radix-ui/react-alert-dialog": "1.1.21",
    "@radix-ui/react-checkbox": "1.3.9",
    "@radix-ui/react-dialog": "1.1.21",
    "@radix-ui/react-label": "2.1.13",
    "@radix-ui/react-select": "2.3.5",
    "@radix-ui/react-slot": "1.3.1",
    "@radix-ui/react-tabs": "~1.1.19",
    "@radix-ui/react-tooltip": "~1.2.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "file-type": "~22.0.1",
    "lucide-react": "1.26.0",
    "mammoth": "~1.12.0",
    "next": "16.2.11",
    "next-auth": "4.24.15",
    "ogl": "~1.0.11",
    "pdf-lib": "~1.17.1",
    "pdf-parse": "~2.4.5",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "server-only": "~0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "jszip": "~3.10.1",
    "prettier": "3.6.2",
    "prisma": "7.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
